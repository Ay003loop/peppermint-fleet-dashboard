# Copy to .env and adjust for local runs. All of these map 1:1 to config.js.

PORT=8080
ADMIN_TOKEN=change-me-before-deploying

# --- simulator knobs (also live-adjustable post-deploy, see README "Live controls") ---
FLEET_SIZE=25
UPDATE_INTERVAL_MS=5000
PAYLOAD_PADDING_BYTES=0

# --- where the simulator finds the backend (only needed if they're not on localhost) ---
BACKEND_INGEST_URL=ws://localhost:8080/ingest
BACKEND_HTTP_URL=http://localhost:8080

# --- backend broadcast / staleness tuning ---
BROADCAST_INTERVAL_MS=500
AGGREGATE_BUCKET_MS=5000
AGGREGATE_HISTORY_LENGTH=4320
MAX_CLIENT_BUFFERED_BYTES=1000000
STALE_AFTER_MS=20000

# --- history persistence (stretch goal) ---
HISTORY_ENABLED=true
DB_PATH=./fleet_history.db
HISTORY_FLUSH_INTERVAL_MS=3000

SITE_WIDTH=900
SITE_HEIGHT=560
