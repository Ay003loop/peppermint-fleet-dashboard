{
  "name": "peppermint-fleet-dashboard",
  "version": "1.0.0",
  "description": "Live fleet management dashboard: simulator -> backend -> browser, for the Peppermint Robotics SDE-1 challenge.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "simulate": "node simulator.js",
    "dev": "concurrently -k -n server,sim -c blue,green \"node server.js\" \"node simulator.js\"",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
